{
  "additionalProperties": false,
  "description": "One tweak the user asked for (`text-2-shorts feedback`), routed to the stage it belongs to.",
  "properties": {
    "id": {
      "pattern": "^r\\d{3}$",
      "title": "Id",
      "type": "string"
    },
    "target": {
      "pattern": "^(outline|script|plan|final|s\\d{2}(c\\d{2})?)$",
      "title": "Target",
      "type": "string"
    },
    "kind": {
      "enum": [
        "wording",
        "visual",
        "audio-timing",
        "accuracy",
        "structure",
        "style",
        "other"
      ],
      "title": "Kind",
      "type": "string"
    },
    "text": {
      "description": "the user's words",
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "checkpoint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the checkpoint it was raised at, if any",
      "title": "Checkpoint"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "target",
    "kind",
    "text",
    "created_at"
  ],
  "title": "ChangeRequest",
  "type": "object"
}
