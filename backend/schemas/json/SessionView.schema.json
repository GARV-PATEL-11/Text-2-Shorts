{
  "$defs": {
    "ClaudeAccount": {
      "additionalProperties": false,
      "description": "The Claude account Claude Code is signed in to on this machine: who the web view's user is.",
      "properties": {
        "email": {
          "title": "Email",
          "type": "string"
        },
        "organization": {
          "default": "",
          "title": "Organization",
          "type": "string"
        },
        "plan": {
          "default": "",
          "title": "Plan",
          "type": "string"
        },
        "method": {
          "default": "",
          "description": "claude.ai (subscription) or console (API billing)",
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "ClaudeAccount",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "GET/POST/DELETE /api/session",
  "properties": {
    "signed_in": {
      "title": "Signed In",
      "type": "boolean"
    },
    "account": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClaudeAccount"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "claude_code_signed_in": {
      "default": true,
      "description": "False: run `claude auth login` first",
      "title": "Claude Code Signed In",
      "type": "boolean"
    }
  },
  "required": [
    "signed_in"
  ],
  "title": "SessionView",
  "type": "object"
}
