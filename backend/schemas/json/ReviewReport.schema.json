{
  "$defs": {
    "ReviewFinding": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "description": "scene id (script review) or clip id (plan review)",
          "pattern": "^s\\d{2}(c\\d{2})?$",
          "title": "Target",
          "type": "string"
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARN"
          ],
          "title": "Severity",
          "type": "string"
        },
        "kind": {
          "enum": [
            "FALSE",
            "UNSTATED",
            "NOTATION",
            "MISLEADING",
            "SPOKEN"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "why": {
          "title": "Why",
          "type": "string"
        },
        "fix": {
          "title": "Fix",
          "type": "string"
        }
      },
      "required": [
        "target",
        "severity",
        "kind",
        "quote",
        "why",
        "fix"
      ],
      "title": "ReviewFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reviewed": {
      "description": "`text-2-shorts hash <run> script` or `\u2026 plans`: the version of the script or plans checked",
      "title": "Reviewed",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ReviewFinding"
      },
      "title": "Findings",
      "type": "array"
    }
  },
  "required": [
    "reviewed",
    "findings"
  ],
  "title": "ReviewReport",
  "type": "object"
}
