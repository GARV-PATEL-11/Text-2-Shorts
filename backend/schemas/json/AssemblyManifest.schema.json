{
  "$defs": {
    "BackgroundMusic": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "volume_db": {
          "default": -24,
          "maximum": 0,
          "minimum": -40,
          "title": "Volume Db",
          "type": "number"
        }
      },
      "required": [
        "file"
      ],
      "title": "BackgroundMusic",
      "type": "object"
    },
    "ManifestClip": {
      "additionalProperties": false,
      "properties": {
        "clip_id": {
          "examples": [
            "s03c02"
          ],
          "pattern": "^s\\d{2}c\\d{2}$",
          "title": "Clip Id",
          "type": "string"
        },
        "video": {
          "title": "Video",
          "type": "string"
        },
        "audio": {
          "title": "Audio",
          "type": "string"
        },
        "lead_in": {
          "default": 0.0,
          "title": "Lead In",
          "type": "number"
        },
        "tail": {
          "default": 0.0,
          "title": "Tail",
          "type": "number"
        },
        "sound_effects": {
          "description": "files as absolute paths",
          "items": {
            "$ref": "#/$defs/SoundEffect"
          },
          "title": "Sound Effects",
          "type": "array"
        }
      },
      "required": [
        "clip_id",
        "video",
        "audio"
      ],
      "title": "ManifestClip",
      "type": "object"
    },
    "ManifestScene": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "examples": [
            "s03"
          ],
          "pattern": "^s\\d{2}$",
          "title": "Scene Id",
          "type": "string"
        },
        "clips": {
          "items": {
            "$ref": "#/$defs/ManifestClip"
          },
          "title": "Clips",
          "type": "array"
        }
      },
      "required": [
        "scene_id",
        "clips"
      ],
      "title": "ManifestScene",
      "type": "object"
    },
    "SceneTransition": {
      "additionalProperties": false,
      "properties": {
        "style": {
          "default": "cut",
          "enum": [
            "cut",
            "fade",
            "crossfade"
          ],
          "title": "Style",
          "type": "string"
        },
        "seconds": {
          "default": 0.5,
          "maximum": 2,
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        }
      },
      "title": "SceneTransition",
      "type": "object"
    },
    "SoundEffect": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "the user's own audio file, relative to the run folder",
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "at": {
          "description": "seconds from the clip's start",
          "minimum": 0,
          "title": "At",
          "type": "number"
        },
        "volume_db": {
          "default": -6,
          "maximum": 6,
          "minimum": -40,
          "title": "Volume Db",
          "type": "number"
        }
      },
      "required": [
        "file",
        "at"
      ],
      "title": "SoundEffect",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "assembly.json: what tools/assemble_clips.py joins into final.mp4.",
  "properties": {
    "scenes": {
      "items": {
        "$ref": "#/$defs/ManifestScene"
      },
      "title": "Scenes",
      "type": "array"
    },
    "transition": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneTransition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "music": {
      "anyOf": [
        {
          "$ref": "#/$defs/BackgroundMusic"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "scenes"
  ],
  "title": "AssemblyManifest",
  "type": "object"
}
