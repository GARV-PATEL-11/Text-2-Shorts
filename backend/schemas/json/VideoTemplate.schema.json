{
  "additionalProperties": false,
  "description": "The video's look and sound (template.json): one variant per element of\nbackend/templates/template_kit/elements.json, from a starter template plus the user's choices; resolved by\nbackend/templates/video_settings.py and audio_settings.py. The assembly fields are ours.",
  "properties": {
    "name": {
      "description": "the starter template it started from",
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "elements": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "element \u2192 variant id (template_kit/elements.json)",
      "title": "Elements",
      "type": "object"
    },
    "overrides": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "description": "custom values merged into a variant (video_settings.CUSTOM)",
      "title": "Overrides",
      "type": "object"
    },
    "scene_transition": {
      "default": "fade",
      "enum": [
        "cut",
        "fade",
        "crossfade"
      ],
      "title": "Scene Transition",
      "type": "string"
    },
    "transition_seconds": {
      "default": 0.5,
      "maximum": 2,
      "minimum": 0,
      "title": "Transition Seconds",
      "type": "number"
    },
    "music": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "path to the user's own background music file (none = silence)",
      "title": "Music"
    },
    "music_volume_db": {
      "default": -24,
      "description": "music level under the voice",
      "maximum": 0,
      "minimum": -40,
      "title": "Music Volume Db",
      "type": "number"
    }
  },
  "required": [
    "name",
    "elements"
  ],
  "title": "VideoTemplate",
  "type": "object"
}
