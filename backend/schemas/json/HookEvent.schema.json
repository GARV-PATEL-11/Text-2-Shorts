    "hook_event_name": {
      "title": "Hook Event Name",
      "type": "string"
    },
    "cwd": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cwd"
    },
    "transcript_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcript Path"
    },
    "tool_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Name"
    },
    "tool_input": {
      "$ref": "#/$defs/HookToolInput"
    },
    "agent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "set when the call comes from a subagent, absent in the session",
      "title": "Agent Id"
    }
  },
  "required": [
    "hook_event_name"
  ],
  "title": "HookEvent",
  "type": "object"
}
