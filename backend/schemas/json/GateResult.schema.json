{
  "$defs": {
    "GateFinding": {
      "additionalProperties": false,
      "description": "A finding of the validator or the layout probe.",
      "properties": {
        "severity": {
          "enum": [
            "ERROR",
            "WARN",
            "INFO"
          ],
          "title": "Severity",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "t": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "seconds into the scene",
          "title": "T"
        },
        "event": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the clip or animation it happened in",
          "title": "Event"
        },
        "mobject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mobject"
        },
        "mobjects": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mobjects"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        }
      },
      "required": [
        "severity",
        "code"
      ],
      "title": "GateFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "checks/<gate>.json written by ./check (compose, static, probe, render, frames).",
  "properties": {
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/GateFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "clip": {
      "anyOf": [
        {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the clip's span in the probe",
      "title": "Clip"
    },
    "beats": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "beat number \u2192 when self.beat(n) ran",
      "title": "Beats",
      "type": "object"
    },
    "video": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Video"
    },
    "duration": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration"
    },
    "frames": {
      "items": {
        "type": "string"
      },
      "title": "Frames",
      "type": "array"
    }
  },
  "required": [
    "ok"
  ],
  "title": "GateResult",
  "type": "object"
}
