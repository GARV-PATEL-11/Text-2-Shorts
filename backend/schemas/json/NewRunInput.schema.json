{
  "$defs": {
    "LookInput": {
      "additionalProperties": false,
      "description": "POST /api/runs/<run>/look (and \u2026/look/voice): a starter template, the elements changed, custom values.",
      "properties": {
        "template": {
          "minLength": 1,
          "title": "Template",
          "type": "string"
        },
        "elements": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "element \u2192 variant; others keep the default",
          "title": "Elements",
          "type": "object"
        },
        "custom": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "element \u2192 the user's own value",
          "title": "Custom",
          "type": "object"
        }
      },
      "required": [
        "template"
      ],
      "title": "LookInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "POST /api/runs: a run started from the website (what `text-2-shorts new` asks).",
  "properties": {
    "requirement": {
      "description": "the topic, in the user's words",
      "maxLength": 2000,
      "minLength": 3,
      "title": "Requirement",
      "type": "string"
    },
    "objectives": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Objectives",
      "type": "array"
    },
    "approach": {
      "default": "zoom",
      "enum": [
        "zoom",
        "arc",
        "linear",
        "creative"
      ],
      "title": "Approach",
      "type": "string"
    },
    "minutes": {
      "default": 2,
      "exclusiveMinimum": 0,
      "maximum": 12,
      "title": "Minutes",
      "type": "number"
    },
    "audience": {
      "default": "curious beginners",
      "maxLength": 300,
      "title": "Audience",
      "type": "string"
    },
    "tts": {
      "default": "polly",
      "enum": [
        "polly",
        "google"
      ],
      "title": "Tts",
      "type": "string"
    },
    "look": {
      "anyOf": [
        {
          "$ref": "#/$defs/LookInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the template chosen in Start a Run's first step (saved and approved)"
    }
  },
  "required": [
    "requirement"
  ],
  "title": "NewRunInput",
  "type": "object"
}
