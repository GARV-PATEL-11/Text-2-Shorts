{
  "$defs": {
    "LookElement": {
      "additionalProperties": false,
      "description": "One element of the tree: a variant per option, maybe a custom value, maybe a gallery sheet of every option.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "group": {
          "title": "Group",
          "type": "string"
        },
        "kind": {
          "enum": [
            "visual",
            "sound"
          ],
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/LookOption"
          },
          "title": "Options",
          "type": "array"
        },
        "custom": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "what a custom value is (e.g. 'colour'); None = variants only",
          "title": "Custom"
        },
        "previewed": {
          "default": false,
          "description": "every option has a picture: /previews/<mode>/<id>/<option>.webp",
          "title": "Previewed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "group",
        "kind",
        "options"
      ],
      "title": "LookElement",
      "type": "object"
    },
    "LookOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "detail": {
          "default": "",
          "description": "what it means beyond its name (voice ids, rate, tone rules)",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "LookOption",
      "type": "object"
    },
    "LookTemplate": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "elements": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Elements",
          "type": "object"
        }
      },
      "required": [
        "name",
        "elements"
      ],
      "title": "LookTemplate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "GET /api/look: the starter templates and every element the user can set.",
  "properties": {
    "templates": {
      "items": {
        "$ref": "#/$defs/LookTemplate"
      },
      "title": "Templates",
      "type": "array"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/LookElement"
      },
      "title": "Elements",
      "type": "array"
    }
  },
  "required": [
    "templates",
    "elements"
  ],
  "title": "LookCatalogue",
  "type": "object"
}
