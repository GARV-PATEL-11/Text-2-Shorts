  "narration_tone": {
   "group": "narration",
   "description": "How the script is worded: a friendly teacher, a calm documentary, an energetic host or a storyteller.",
   "variants": [
    {
     "id": "friendly_teacher",
     "label": "Friendly teacher",
     "max_sentence_words": 20,
     "script_rules": "Speak to one learner as 'you'; use 'we' when working things out. One idea per sentence. Name what is on screen before explaining it.",
     "polly_newscaster": false
    },
    {
     "id": "documentary",
     "label": "Calm documentary",
     "max_sentence_words": 24,
     "script_rules": "Third person, measured and vivid. No questions to the viewer. Let visuals breathe: short sentences between animations.",
     "polly_newscaster": true
    },
    {
     "id": "energetic",
     "label": "Energetic",
     "max_sentence_words": 14,
     "script_rules": "Short punchy sentences, active verbs, one surprising hook per section. Never more than one exclamation per section.",
     "polly_newscaster": false
    },
    {
     "id": "formal_academic",
     "label": "Formal academic",
     "max_sentence_words": 26,
     "script_rules": "Precise terminology, define each term once, no slang or contractions. State assumptions before results.",
     "polly_newscaster": true
    },
    {
     "id": "storyteller",
     "label": "Storyteller",
     "max_sentence_words": 22,
     "script_rules": "Frame each idea as a small story or problem someone faced. Build tension, then reveal the result on screen.",
     "polly_newscaster": false
    },
    {
     "id": "conversational",
     "label": "Conversational",
     "max_sentence_words": 18,
     "script_rules": "Natural spoken English with contractions. Think aloud, admit where things are tricky, keep jargon out unless shown.",
     "polly_newscaster": false
    },
    {
     "id": "encouraging",
     "label": "Encouraging",
     "max_sentence_words": 16,
     "script_rules": "Assume a beginner. Praise progress, warn before hard steps, recap after each section in one sentence.",
     "polly_newscaster": false
    }
   ]
