# Text-to-Shorts — environment template. Copy to .env (never commit .env).
# ── Claude ────────────────────────────────────────────────────────────────────
# The runner shells out to `claude -p`. Auth is whatever the CLI is logged in with
# (`claude auth status`): a Console API key (billed per token) or a subscription token
# (`claude setup-token` → CLAUDE_CODE_OAUTH_TOKEN, subject to plan usage limits).
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
T2S_MODEL=                      # optional: force one model alias everywhere (cheap smoke runs), e.g. haiku
# ── Manim / rendering ────────────────────────────────────────────────────────
T2S_MANIM_PIN=0.20.1
T2S_API_INDEX=cache/manim_api/0.20.1/index.json
T2S_FPS=60                      # 60–120; output is always 2560x1440 (16:9)
# ── TTS ──────────────────────────────────────────────────────────────────────
TTS_ENGINE=kokoro               # kokoro (local) | neural | generative | standard (AWS Polly engines)
KOKORO_VOICE=af_heart
KOKORO_DIR=~/.cache/kokoro
KOKORO_MODEL_SHA256=            # PROPOSED: pin the downloaded model files (today they are fetched unpinned)
POLLY_VOICE=Matthew
AWS_REGION=us-east-1            # Polly only; credentials via the standard AWS chain, never in the sandbox
