# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# ── Gemini key pool (managed by PoolGate) ─────────────────────────────────────
# Obtain keys from https://aistudio.google.com/app/apikey
# Set TOTAL_GEMINI_KEYS to the number of keys you have, then list each one.
TOTAL_GEMINI_KEYS=1
GEMINI_API_KEY_01=your_gemini_api_key

# Add more keys for higher throughput:
 GEMINI_API_KEY_02=your_second_gemini_api_key
 GEMINI_API_KEY_03=your_third_gemini_api_key

# ── Gemini model selection ────────────────────────────────────────────────────
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# ── Gemini pool tuning (optional — defaults shown) ────────────────────────────
 GEMINI_MAX_RPM=5
 GEMINI_MAX_ACTIVE=5
 GEMINI_COOLDOWN_SECS=60
 GEMINI_FAILURE_THRESHOLD=3
 GEMINI_BATCH_CONCURRENCY=10
 GEMINI_MAX_RETRIES=3
 GEMINI_BASE_BACKOFF=1.0
 GEMINI_MAX_BACKOFF=30.0
 GEMINI_SESSION_TTL_HOURS=24
 GEMINI_DEBUG=false
 GEMINI_LOG_LEVEL=INFO

# ── S3 (optional — for video preview uploads) ─────────────────────────────────
# S3_BUCKET_NAME=your_s3_bucket_name
# S3_KEY_PREFIX=video-previews
