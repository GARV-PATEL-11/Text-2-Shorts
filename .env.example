# Faraday settings. Copy to .env (never committed) and change what you need; every value here is the default.

# ── Voiceover ─────────────────────────────────────────────────────────────────
# TEXT_2_SHORTS_TTS: polly (default) | google — chosen per video with `text-2-shorts new --tts …`. Both get SSML pauses and word
# timings (beat sync). Pronunciation of symbols, units, abbreviations and M-vs-m is handled for both (backend/app/narration.py).
TEXT_2_SHORTS_TTS=polly
POLLY_ENGINE=neural            # neural | generative | standard
POLLY_VOICE=Matthew            # neural: Matthew, Joanna, Ruth, Stephen · generative: Ruth, Stephen, …
GOOGLE_VOICE=en-US-Neural2-D   # e.g. en-US-Neural2-F, en-US-Studio-O, en-GB-Neural2-B (Chirp 3 HD: no SSML → no timings)

# ── AWS Polly ─────────────────────────────────────────────────────────────────
# Uses your ~/.aws credentials by default. Only uncomment these to override them.
# AWS_PROFILE=default
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Google Cloud TTS ──────────────────────────────────────────────────────────
# Uses Application Default Credentials: `gcloud auth application-default login`, or uncomment:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Rendering ─────────────────────────────────────────────────────────────────
# Drafts and previews render at 1280x720, 30 fps; the final delivery at 2560x1440 (16:9), 60–120 fps
# TEXT_2_SHORTS_FPS=120
# Scenes rendered at once by `text-2-shorts final`
# TEXT_2_SHORTS_PARALLEL=4
