# ── Voiceover ─────────────────────────────────────────────────────────────────
# TTS_ENGINE=kokoro (default: local, free; ~350MB model auto-downloads to ~/.cache/kokoro)
#   or a Polly engine: neural | generative | standard
TTS_ENGINE=kokoro
KOKORO_VOICE=af_heart
# KOKORO_DIR=~/.cache/kokoro

# ── AWS Polly (only when TTS_ENGINE is a Polly engine) ─────────────────────────────────────────────────────
# Leave unset to use your ~/.aws credentials; or set AWS_PROFILE to pick a profile.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
# AWS_PROFILE=default

# Default voice for `pipeline new` (the /make-short skill asks anyway).
# Generative voices (Ruth, Stephen, …) need POLLY_ENGINE=generative.
POLLY_VOICE=Matthew
POLLY_ENGINE=neural

# ── Claude Code stages (auth = your logged-in `claude` CLI) ───────────────────
# Force one model for every stage, e.g. for cheap smoke runs: T2S_MODEL=haiku
# T2S_MODEL=
# Final Manim render quality: -ql | -qm | -qh | -qk
# T2S_QUALITY=-qh
# Scenes processed at once (plan + render); lower it if you hit usage limits
# T2S_PARALLEL=4
