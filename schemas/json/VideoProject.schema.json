{
  "$defs": {
    "Brief": {
      "additionalProperties": false,
      "description": "Stage 1 \u2014 the user's requirements, written by `text-2-shorts new` and confirmed with the user.",
      "properties": {
        "requirement": {
          "description": "the topic and request in the user's words",
          "minLength": 1,
          "title": "Requirement",
          "type": "string"
        },
        "objectives": {
          "description": "what the viewer should be able to do or explain",
          "items": {
            "type": "string"
          },
          "title": "Objectives",
          "type": "array"
        },
        "audience": {
          "default": "curious beginners",
          "title": "Audience",
          "type": "string"
        },
        "style": {
          "default": "ELI5 / Feynman",
          "description": "explanation style and tone",
          "title": "Style",
          "type": "string"
        },
        "approach": {
          "default": "zoom",
          "description": "narrative structure: three fixed ones, or 'creative' (designed for this topic, or the user's own)",
          "enum": [
            "zoom",
            "arc",
            "linear",
            "creative"
          ],
          "title": "Approach",
          "type": "string"
        },
        "minutes": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 12,
          "title": "Minutes",
          "type": "number"
        },
        "pace": {
          "default": "medium",
          "enum": [
            "slow",
            "medium",
            "fast"
          ],
          "title": "Pace",
          "type": "string"
        },
        "notes": {
          "default": "",
          "description": "constraints and anything else the user asked for",
          "title": "Notes",
          "type": "string"
        },
        "tts": {
          "default": "polly",
          "enum": [
            "polly",
            "google"
          ],
          "title": "Tts",
          "type": "string"
        },
        "voice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice"
        },
        "engine": {
          "default": "neural",
          "enum": [
            "neural",
            "generative",
            "standard"
          ],
          "title": "Engine",
          "type": "string"
        },
        "font": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font"
        }
      },
      "required": [
        "requirement"
      ],
      "title": "Brief",
      "type": "object"
    },
    "EnvironmentReport": {
      "additionalProperties": false,
      "properties": {
        "manim_version": {
          "title": "Manim Version",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "claude_code_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claude Code Version"
        },
        "latex": {
          "title": "Latex",
          "type": "boolean"
        },
        "dvisvgm": {
          "title": "Dvisvgm",
          "type": "boolean"
        },
        "ffmpeg": {
          "title": "Ffmpeg",
          "type": "boolean"
        },
        "bwrap": {
          "title": "Bwrap",
          "type": "boolean"
        },
        "socat": {
          "title": "Socat",
          "type": "boolean"
        },
        "api_index_hash": {
          "title": "Api Index Hash",
          "type": "string"
        }
      },
      "required": [
        "manim_version",
        "python_version",
        "latex",
        "dvisvgm",
        "ffmpeg",
        "bwrap",
        "socat",
        "api_index_hash"
      ],
      "title": "EnvironmentReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "pattern": "^\\d{8}-\\d{6}-[a-z0-9-]{1,40}$",
      "title": "Project Id",
      "type": "string"
    },
    "brief": {
      "$ref": "#/$defs/Brief"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentReport"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "brief",
    "environment"
  ],
  "title": "VideoProject",
  "type": "object"
}