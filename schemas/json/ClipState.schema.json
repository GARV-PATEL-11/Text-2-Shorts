{
  "$defs": {
    "ApprovalState": {
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "revision_requested",
        "rejected",
        "stale"
      ],
      "title": "ApprovalState",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "description": "path relative to the run directory",
          "title": "Path",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path",
        "version",
        "content_hash"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "not_run",
        "passed",
        "passed_with_warnings",
        "failed"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Row in the run ledger (runs/<id>/state.json). The ledger, not chat history, is the source of truth.",
  "properties": {
    "clip_id": {
      "examples": [
        "s03c02"
      ],
      "pattern": "^s\\d{2}c\\d{2}$",
      "title": "Clip Id",
      "type": "string"
    },
    "plan_version": {
      "default": 1,
      "title": "Plan Version",
      "type": "integer"
    },
    "plan_hash": {
      "title": "Plan Hash",
      "type": "string"
    },
    "approval": {
      "$ref": "#/$defs/ApprovalState",
      "default": "draft"
    },
    "audio": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "spec": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "render": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "validations": {
      "additionalProperties": {
        "$ref": "#/$defs/ValidationStatus"
      },
      "title": "Validations",
      "type": "object"
    },
    "attempts": {
      "default": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    }
  },
  "required": [
    "clip_id",
    "plan_hash"
  ],
  "title": "ClipState",
  "type": "object"
}