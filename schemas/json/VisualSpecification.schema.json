{
  "$defs": {
    "ContinuityState": {
      "additionalProperties": false,
      "description": "What is on screen at a boundary. Used as exit contract of clip N and entry contract of clip N+1.",
      "properties": {
        "persistent_objects": {
          "description": "registry names that must be visible",
          "items": {
            "type": "string"
          },
          "title": "Persistent Objects",
          "type": "array"
        },
        "object_positions": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "name \u2192 semantic zone, e.g. 'eq_main': 'top_center'",
          "title": "Object Positions",
          "type": "object"
        },
        "descriptions": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "name \u2192 what the object is (type, text or LaTeX, colour, size), so a clip built on its own can re-create the objects it takes over",
          "title": "Descriptions",
          "type": "object"
        },
        "camera": {
          "default": "default_frame",
          "title": "Camera",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "ContinuityState",
      "type": "object"
    },
    "GenerationMetadata": {
      "additionalProperties": false,
      "properties": {
        "producer": {
          "description": "agent/tool name, e.g. 'clip_codegen' or 'validate_manim_code'",
          "title": "Producer",
          "type": "string"
        },
        "producer_kind": {
          "enum": [
            "llm",
            "deterministic",
            "human"
          ],
          "title": "Producer Kind",
          "type": "string"
        },
        "prompt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "prompt template id + version, e.g. 'clip_codegen@3'",
          "title": "Prompt Id"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "input_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "artifact key \u2192 content hash consumed",
          "title": "Input Hashes",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "cache_read_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read Tokens"
        },
        "cache_write_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write Tokens"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "attempt": {
          "default": 1,
          "title": "Attempt",
          "type": "integer"
        }
      },
      "required": [
        "producer",
        "producer_kind"
      ],
      "title": "GenerationMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Clip-level visual plan (replaces the scene-level XML DSL as the unit of planning).",
  "properties": {
    "clip_id": {
      "examples": [
        "s03c02"
      ],
      "pattern": "^s\\d{2}c\\d{2}$",
      "title": "Clip Id",
      "type": "string"
    },
    "objects": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "registry name \u2192 Manim class + style, e.g. 'eq_main': 'MathTex FORMULA WHITE'",
      "title": "Objects",
      "type": "object"
    },
    "layout": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "registry name \u2192 semantic zone",
      "title": "Layout",
      "type": "object"
    },
    "steps": {
      "description": "[{beat, call, run_time, rate_func, narration_anchor}]",
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "exit_state": {
      "$ref": "#/$defs/ContinuityState"
    },
    "docs_used": {
      "items": {
        "type": "string"
      },
      "title": "Docs Used",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/GenerationMetadata"
    }
  },
  "required": [
    "clip_id",
    "objects",
    "layout",
    "steps",
    "exit_state",
    "meta"
  ],
  "title": "VisualSpecification",
  "type": "object"
}