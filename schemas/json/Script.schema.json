{
  "$defs": {
    "ScriptScene": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "examples": [
            "s03"
          ],
          "pattern": "^s\\d{2}$",
          "title": "Scene Id",
          "type": "string"
        },
        "role": {
          "default": "content",
          "description": "s01 is the index scene: it tells the viewer what the video covers",
          "enum": [
            "index",
            "content",
            "recap"
          ],
          "title": "Role",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "objective": {
          "description": "what this scene teaches, in one sentence",
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "key_concepts": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Key Concepts",
          "type": "array"
        },
        "covers": {
          "description": "1-based indexes into Script.objectives it teaches",
          "items": {
            "type": "integer"
          },
          "title": "Covers",
          "type": "array"
        },
        "previews": {
          "description": "index scene only: every later scene, in order",
          "items": {
            "examples": [
              "s03"
            ],
            "pattern": "^s\\d{2}$",
            "type": "string"
          },
          "title": "Previews",
          "type": "array"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "bridge_in": {
          "default": "",
          "description": "spoken inter-scene transition at the start of this scene: what was just covered, what comes next, why it matters. Empty for the first scene.",
          "title": "Bridge In",
          "type": "string"
        },
        "narration": {
          "description": "the complete spoken text of the scene after the bridge",
          "minLength": 1,
          "title": "Narration",
          "type": "string"
        },
        "visual_idea": {
          "default": "",
          "description": "one or two sentences; the scene's visual plan holds the detail",
          "title": "Visual Idea",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "title",
        "objective",
        "key_concepts",
        "duration_seconds",
        "narration"
      ],
      "title": "ScriptScene",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "structure": {
      "description": "narrative structure used, e.g. zoom, arc, linear, custom",
      "minLength": 1,
      "title": "Structure",
      "type": "string"
    },
    "objectives": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Objectives",
      "type": "array"
    },
    "target_wpm": {
      "default": 150,
      "maximum": 220,
      "minimum": 90,
      "title": "Target Wpm",
      "type": "integer"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/ScriptScene"
      },
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    }
  },
  "required": [
    "title",
    "structure",
    "objectives",
    "scenes"
  ],
  "title": "Script",
  "type": "object"
}