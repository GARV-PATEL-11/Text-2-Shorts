{
  "$defs": {
    "ClipPlan": {
      "additionalProperties": false,
      "properties": {
        "clip_id": {
          "examples": [
            "s03c02"
          ],
          "pattern": "^s\\d{2}c\\d{2}$",
          "title": "Clip Id",
          "type": "string"
        },
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "objective": {
          "description": "one teaching purpose; if you need 'and', split the clip",
          "title": "Objective",
          "type": "string"
        },
        "narration": {
          "description": "exact spoken text for this clip (TTS input)",
          "title": "Narration",
          "type": "string"
        },
        "ssml": {
          "description": "the clip's audio plan: <speak> SSML over exactly the narration's words \u2014 <break> for waits, <prosody rate> for pace, <emphasis>, <s>/<p>, <sub>, <say-as>",
          "title": "Ssml",
          "type": "string"
        },
        "on_screen_math": {
          "description": "LaTeX strings that must appear",
          "items": {
            "type": "string"
          },
          "title": "On Screen Math",
          "type": "array"
        },
        "visual_intent": {
          "description": "what the viewer sees, 2\u20136 sentences, no code",
          "title": "Visual Intent",
          "type": "string"
        },
        "beats": {
          "description": "ordered visual events synced to narration phrases",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Beats",
          "type": "array"
        },
        "entry": {
          "$ref": "#/$defs/ContinuityState"
        },
        "exit": {
          "$ref": "#/$defs/ContinuityState"
        },
        "est_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 45,
          "title": "Est Seconds",
          "type": "number"
        },
        "depends_on": {
          "items": {
            "examples": [
              "s03c02"
            ],
            "pattern": "^s\\d{2}c\\d{2}$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "manim_topics": {
          "description": "topic card names, e.g. ['mathtex-indexing', 'axes-and-graphs']",
          "items": {
            "type": "string"
          },
          "title": "Manim Topics",
          "type": "array"
        }
      },
      "required": [
        "clip_id",
        "index",
        "objective",
        "narration",
        "ssml",
        "visual_intent",
        "beats",
        "entry",
        "exit",
        "est_seconds"
      ],
      "title": "ClipPlan",
      "type": "object"
    },
    "ContinuityState": {
      "additionalProperties": false,
      "description": "What is on screen at a boundary. Used as exit contract of clip N and entry contract of clip N+1.",
      "properties": {
        "persistent_objects": {
          "description": "registry names that must be visible",
          "items": {
            "type": "string"
          },
          "title": "Persistent Objects",
          "type": "array"
        },
        "object_positions": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "name \u2192 semantic zone, e.g. 'eq_main': 'top_center'",
          "title": "Object Positions",
          "type": "object"
        },
        "descriptions": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "name \u2192 what the object is (type, text or LaTeX, colour, size), so a clip built on its own can re-create the objects it takes over",
          "title": "Descriptions",
          "type": "object"
        },
        "camera": {
          "default": "default_frame",
          "title": "Camera",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "ContinuityState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scene_id": {
      "examples": [
        "s03"
      ],
      "pattern": "^s\\d{2}$",
      "title": "Scene Id",
      "type": "string"
    },
    "index": {
      "minimum": 1,
      "title": "Index",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "composition": {
      "description": "layout zones and the main visual elements of the scene, 2\u20134 sentences",
      "minLength": 1,
      "title": "Composition",
      "type": "string"
    },
    "transition_in": {
      "default": "",
      "description": "how the scene opens from the previous scene's final image; empty for the first scene",
      "title": "Transition In",
      "type": "string"
    },
    "clips": {
      "items": {
        "$ref": "#/$defs/ClipPlan"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Clips",
      "type": "array"
    },
    "color_roles": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "semantic role \u2192 Manim color constant",
      "title": "Color Roles",
      "type": "object"
    }
  },
  "required": [
    "scene_id",
    "index",
    "title",
    "objective",
    "composition",
    "clips"
  ],
  "title": "ScenePlan",
  "type": "object"
}