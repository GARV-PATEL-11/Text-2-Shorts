{
  "$defs": {
    "CritiqueIssue": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "description": "the scene or clip the issue is about",
          "pattern": "^s\\d{2}(c\\d{2})?$",
          "title": "Target",
          "type": "string"
        },
        "aspect": {
          "description": "plan: clarity \u00b7 sync \u00b7 constructability \u00b7 design; video: plan-match \u00b7 sync \u00b7 render \u00b7 design",
          "title": "Aspect",
          "type": "string"
        },
        "problem": {
          "title": "Problem",
          "type": "string"
        },
        "fix": {
          "title": "Fix",
          "type": "string"
        }
      },
      "required": [
        "target",
        "aspect",
        "problem",
        "fix"
      ],
      "title": "CritiqueIssue",
      "type": "object"
    },
    "CritiqueRound": {
      "additionalProperties": false,
      "properties": {
        "reviewed": {
          "description": "`text-2-shorts hash <run> sNN plan|video` of the version reviewed",
          "title": "Reviewed",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "pass",
            "revise"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/CritiqueIssue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "reviewed",
        "verdict"
      ],
      "title": "CritiqueRound",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "rounds": {
      "items": {
        "$ref": "#/$defs/CritiqueRound"
      },
      "minItems": 1,
      "title": "Rounds",
      "type": "array"
    }
  },
  "required": [
    "rounds"
  ],
  "title": "Critique",
  "type": "object"
}