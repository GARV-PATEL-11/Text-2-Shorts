{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["Bash(text-2-shorts:*)", "Bash(./check:*)", "Bash(ls:*)", "Bash(ffprobe:*)", "Bash(ffmpeg:*)"],
    "deny": ["Read(~/.aws/**)", "Read(~/.ssh/**)", "Read(~/.config/gcloud/**)", "Read(~/.netrc)", "Read(**/.env)"]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": ["text-2-shorts voice", "text-2-shorts accept", "text-2-shorts final"],
    "filesystem": {
      "allowWrite": ["~/.cache/manim", "~/.cache/fontconfig"],
      "denyRead": ["~/.aws", "~/.ssh", "~/.config/gcloud", "~/.netrc", "./.env"]
    },
    "network": { "allowedDomains": [] }
  }
}
